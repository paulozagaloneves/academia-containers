meta {
  name: Registar evento minimo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "tipo": "login"
  }
}

assert {
  res.status: eq 201
  res.body.tipo: eq "login"
  res.body.transacao_id: isNull
  res.body.valor: isNull
}

script:post-response {
  bru.setVar("eventoMinimoId", res.body.id);
}

docs {
  Campos opcionais não enviados aparecem como null.
}
