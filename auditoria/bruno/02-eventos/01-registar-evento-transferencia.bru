meta {
  name: Registar evento transferencia
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "tipo": "transferencia",
    "transacao_id": "bruno-tx-0001",
    "origem_id": "11111111-1111-1111-1111-111111111111",
    "destino_id": "22222222-2222-2222-2222-222222222222",
    "valor": "150.75",
    "versao_app": "v1"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.recebido_em: isString
  res.body.tipo: eq "transferencia"
  res.body.valor: eq "150.75"
}

script:pre-request {
  bru.setVar("hoje", new Date().toISOString().slice(0, 10));
}

script:post-response {
  bru.setVar("eventoId", res.body.id);
}

tests {
  test("recebido_em é ISO-8601 de hoje (UTC)", function() {
    expect(res.body.recebido_em.slice(0, 10)).to.equal(bru.getVar("hoje"));
  });
}
