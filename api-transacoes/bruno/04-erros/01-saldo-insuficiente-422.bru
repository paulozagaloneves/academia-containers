meta {
  name: Saldo insuficiente 422
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transferencias
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "origem_id": "22222222-2222-2222-2222-222222222222",
    "destino_id": "11111111-1111-1111-1111-111111111111",
    "valor": "999999999.00"
  }
}

assert {
  res.status: eq 422
  res.body.detail: contains "debito falhou"
}
