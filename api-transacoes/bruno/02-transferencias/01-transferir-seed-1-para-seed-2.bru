meta {
  name: Transferir seed 1 para seed 2
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/transferencias
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "origem_id": "11111111-1111-1111-1111-111111111111",
    "destino_id": "22222222-2222-2222-2222-222222222222",
    "valor": "10.00"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.origem_id: eq "11111111-1111-1111-1111-111111111111"
  res.body.destino_id: eq "22222222-2222-2222-2222-222222222222"
  res.body.status: eq "concluida"
}

script:post-response {
  bru.setVar("txId", res.body.id);
}

tests {
  test("valor = 10", function() {
    expect(Number(res.body.valor)).to.equal(10);
  });
  test("header X-App-Version presente", function() {
    expect(res.headers["x-app-version"]).to.be.a("string");
  });
}
