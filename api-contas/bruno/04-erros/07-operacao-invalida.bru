meta {
  name: Operação inválida
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/contas/22222222-2222-2222-2222-222222222222/saldo
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "valor": "1.00",
    "operacao": "estorno"
  }
}

tests {
  test("erro de validação devolve 400 ou 422", function() {
    expect([400, 422]).to.include(res.status);
  });
  test("corpo tem detail ou errors", function() {
    expect(res.body.detail || res.body.errors).to.exist;
  });
}
