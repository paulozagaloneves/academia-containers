meta {
  name: Documento duplicado 409
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/contas
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "titular": "Duplicado",
    "documento": "12345678901",
    "senha": "abcd",
    "saldo_inicial": 0
  }
}

assert {
  res.status: eq 409
  res.body.detail: eq "documento ja cadastrado"
}
