meta {
  name: Titular curto
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/contas
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "titular": "Ab",
    "documento": "55566677788",
    "senha": "abcd"
  }
}

tests {
  test("erro de validação devolve 400 ou 422", function() {
    expect([400, 422]).to.include(res.status);
  });
  test("corpo tem detail ou errors", function() {
    expect(res.body.detail || res.body.errors).to.exist;
  });
}
