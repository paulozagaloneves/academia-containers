meta {
  name: Obter conta seed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/contas/11111111-1111-1111-1111-111111111111
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq "11111111-1111-1111-1111-111111111111"
  res.body.titular: eq "Jeferson Fernando"
  res.body.documento: eq "12345678901"
}

tests {
  test("saldo é numérico", function() {
    expect(Number(res.body.saldo)).to.be.a("number").and.not.NaN;
  });
}
